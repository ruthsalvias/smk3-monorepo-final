  "reason": "Portfolio belum memenuhi standar, silakan revisi"
}

### 👤 DELETE PORTFOLIO (SISWA)
DELETE {{baseUrl}}/portofolio/1
Authorization: Bearer {{token}}
Content-Type: {{contentType}}

