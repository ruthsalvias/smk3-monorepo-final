    {
      "name": "Berita (News)",
      "item": [
        {
          "name": "Get All News",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3003/api/berita?page=1&limit=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["api", "berita"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Get paginated list of all news (PUBLIC)"
          }
        },
        {
          "name": "Get News by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3003/api/berita/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["api", "berita", "1"]
            },
            "description": "Get specific news by ID (PUBLIC)"
          }
        },
        {
          "name": "Create News",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer YOUR_ADMIN_TOKEN",
                "description": "Admin JWT Token required"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Judul Berita Terbaru\",\n  \"content\": \"Ini adalah konten berita yang lengkap dan informatif tentang acara sekolah terbaru kami.\",\n  \"description\": \"Deskripsi singkat berita\",\n  \"excerpt\": \"Kutipan singkat untuk preview\",\n  \"imageUrl\": \"http://localhost:3003/uploads/berita-1.jpg\",\n  \"categoryId\": 1,\n  \"isFeatured\": true\n}"
            },
            "url": {
              "raw": "http://localhost:3003/api/berita",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["api", "berita"]
            },
            "description": "Create new news (ADMIN only)"
          }
        },
        {
          "name": "Update News",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer YOUR_ADMIN_OR_GURU_TOKEN",
                "description": "Admin or Guru JWT Token required"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Judul Berita Update\",\n  \"content\": \"Konten berita yang telah diperbarui.\",\n  \"description\": \"Deskripsi update\",\n  \"isFeatured\": false\n}"
            },
            "url": {
              "raw": "http://localhost:3003/api/berita/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["api", "berita", "1"]
            },
            "description": "Update news (ADMIN & GURU)"
          }
        },
        {
          "name": "Delete News",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer YOUR_ADMIN_TOKEN",
                "description": "Admin JWT Token required"
              }
            ],
            "url": {
              "raw": "http://localhost:3003/api/berita/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3003",
              "path": ["api", "berita", "1"]
            },
            "description": "Delete news (ADMIN only)"
          }
        }
      ]
