{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/api-gateway",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
  "deleteOutDir": true,
  "webpack": true,
  "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
},
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": { "tsConfigPath": "apps/api-gateway/tsconfig.app.json" }
    },
    "service-berita": {
      "type": "application",
      "root": "apps/service-berita",
      "entryFile": "main",
      "sourceRoot": "apps/service-berita/src",
      "compilerOptions": { "tsConfigPath": "apps/service-berita/tsconfig.app.json" }
    },
    "service-management": {
      "type": "application",
      "root": "apps/service-management",
      "entryFile": "main",
      "sourceRoot": "apps/service-management/src",
      "compilerOptions": { "tsConfigPath": "apps/service-management/tsconfig.app.json" }
    },
    "service-pelanggaran": {
      "type": "application",
      "root": "apps/service-pelanggaran",
      "entryFile": "main",
      "sourceRoot": "apps/service-pelanggaran/src",
      "compilerOptions": { "tsConfigPath": "apps/service-pelanggaran/tsconfig.app.json" }
    },
    "service-portofolio": {
      "type": "application",
      "root": "apps/service-portofolio",
      "entryFile": "main",
      "sourceRoot": "apps/service-portofolio/src",
      "compilerOptions": { "tsConfigPath": "apps/service-portofolio/tsconfig.app.json" }
    },
    "service-profile": {
      "type": "application",
      "root": "apps/service-profile",
      "entryFile": "main",
      "sourceRoot": "apps/service-profile/src",
      "compilerOptions": { "tsConfigPath": "apps/service-profile/tsconfig.app.json" }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": { "tsConfigPath": "libs/common/tsconfig.lib.json" }
    }
  }
}